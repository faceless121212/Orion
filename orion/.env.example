# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=replace_for_server_only_tasks

# Anthropic (server-only; enables AI system-prompt generation, missions in Phase 3)
ANTHROPIC_API_KEY=replace_with_a_new_server_only_key

# Pipedream Connect (used in later phases)
PIPEDREAM_PROJECT_ID=replace_me
PIPEDREAM_CLIENT_ID=replace_me
PIPEDREAM_CLIENT_SECRET=replace_me
PIPEDREAM_ENVIRONMENT=development

# App
NEXT_PUBLIC_APP_NAME=Orion
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated exact email addresses allowed to create an account
REGISTRATION_ALLOWED_EMAILS=owner@example.com

# Required browser-test accounts (use dedicated test users)
E2E_USER_EMAIL=user@example.com
E2E_USER_PASSWORD=replace_me
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=replace_me
